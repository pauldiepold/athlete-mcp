{
  "name": "web",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "deploy:dev": "nuxt build && wrangler deploy",
    "deploy:prod": "nuxt build && wrangler deploy --env production",
    "dev:cron": "nuxt build && wrangler dev --test-scheduled",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "cf-typegen": "wrangler types ./shared/worker-configuration.d.ts",
    "postinstall": "nuxt prepare && wrangler types ./shared/worker-configuration.d.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nuxt/eslint": "1.16.0",
    "@nuxt/ui": "4.9.0",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.4.0",
    "eslint": "^10.8.1",
    "h3": "^1.15.11",
    "marked": "^18.0.9",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "0.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vue": "^3.5.41",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@iconify-json/lucide": "^1.2.123",
    "@types/node": "^26.2.0",
    "nitro-cloudflare-dev": "^0.2.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "wrangler": "^4.122.0"
  }
}
