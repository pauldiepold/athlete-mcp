src/garmin/__fixtures__/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / Wrangler
node_modules/
.wrangler/
dist/

# IDE
.idea/

# Arbeitskopien der Agenten-Worktrees
.claude/worktrees/
